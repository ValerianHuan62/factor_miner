# 运行模式：design、synthetic、smoke 或 visible。
FM_MODE=visible

# 数据发布和运行产物必须使用不同目录。
FM_MARKET_URI=
FM_STATE_URI=
FM_LABEL_URI=
FM_ARTIFACT_ROOT=
FM_SMOKE_INPUT_ROOT=
FM_DERIVED_RELEASE_ROOT=
FM_QUANTLAKE_ROOT=

# 数据与发布身份。
FM_DATA_ORIGIN=local_files
FM_RESOLVED_RELEASE_ID=
FM_RELEASE_MANIFEST_PATH=
FM_RELEASE_MANIFEST_SHA256=
FM_SCHEMA_VERSION=standard-panel-v1
FM_MARKET_CUTOFF=
FM_ADJUSTMENT_CONVENTION=
FM_CALENDAR_VERSION=
FM_STATE_TABLE_VERSION=
FM_STATE_TABLE_CUTOFF=

# 代码与配置身份。
FM_CODE_COMMIT=
FM_CONFIG_PATH=
FM_CONFIG_HASH=

# 完整系统必需的 PostgreSQL 读模型。
FM_DASHBOARD_DSN=
