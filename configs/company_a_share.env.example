# 运行模式：design、synthetic、smoke 或 visible。
FM_MODE=

# QuantLake 只读根目录；真实模式必须填写 /data/quantlake。
FM_QUANTLAKE_ROOT=

# 可选的服务器侧标准化派生发布根目录；必须由清单逐文件绑定只读 QuantLake 上游及输出哈希。
FM_DERIVED_RELEASE_ROOT=

# 独立 artifact 根目录；真实模式必须位于 /data 下且不能位于 QuantLake 内。
FM_ARTIFACT_ROOT=

# 冒烟测试的有界输入根目录；默认是 artifact root 下的 inputs。
FM_SMOKE_INPUT_ROOT=

# 服务器私有 release 中的行情、状态和标签 Parquet 路径。
FM_MARKET_URI=
FM_STATE_URI=
FM_LABEL_URI=

# 冻结参考因子清单。冒烟模式只读编译元数据；可见模式还核验并读取声明的 Parquet。
FM_REFERENCE_MANIFEST_PATH=
FM_REFERENCE_MANIFEST_SHA256=

# 数据来源，真实公司 A 股模式必须为 server_quantlake。
FM_DATA_ORIGIN=

# 数据 release 与 manifest provenance。
FM_RESOLVED_RELEASE_ID=
FM_RELEASE_MANIFEST_PATH=
FM_RELEASE_MANIFEST_SHA256=

# 数据 schema、截止日期、复权和交易日历 provenance。
FM_SCHEMA_VERSION=
FM_MARKET_CUTOFF=
FM_ADJUSTMENT_CONVENTION=
FM_CALENDAR_VERSION=

# 状态表版本与截止日期 provenance。
FM_STATE_TABLE_VERSION=
FM_STATE_TABLE_CUTOFF=

# 运行审计字段；真实服务器配置必须显式填写，不能使用默认值。
FM_CODE_COMMIT=
FM_CONFIG_PATH=
# 对配置文件中除 FM_CONFIG_HASH 外全部 FM_ 字段计算规范 JSON SHA-256。
FM_CONFIG_HASH=
